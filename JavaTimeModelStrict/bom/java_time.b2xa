  <class>
    <businessName>com.ibm.odm.time.DayOfWeek</businessName>
    <executionName>java.time.DayOfWeek</executionName>
    <extenderName>com.ibm.ia.rules.model.extender.DayOfWeekExtender</extenderName>
    <method>
        <name>java.util.Date</name>
        <parameter type="com.ibm.odm.time.DayOfWeek"/>
        <body language="arl"><![CDATA[
        java.util.Calendar cal = java.util.Calendar.getInstance(java.util.TimeZone.getTimeZone("UTC"));
        cal.clear();
        cal.set(java.util.Calendar.DAY_OF_WEEK, (dow.getValue() % 7) + 1);
        return cal.getTime();
        ]]></body>
    </method>
  </class>

