  <class>   
    <businessName>com.ibm.odm.time.Year</businessName>
    <executionName>java.time.Year</executionName>
    <extenderName>com.ibm.ia.rules.model.extender.YearExtender</extenderName>
    <method>
        <name>com.ibm.odm.time.Year</name>
        <parameter type="long"/>
        <body language="arl"><![CDATA[        
		return java.time.Year.of((int) value);
        ]]></body>
    </method>
    <method>
        <name>java.util.Date</name>
        <parameter type="com.ibm.odm.time.Year"/>
        <body language="arl"><![CDATA[
        java.util.Calendar cal = java.util.Calendar.getInstance(java.util.TimeZone.getTimeZone("UTC"));
        cal.clear();
        cal.set(java.util.Calendar.YEAR, year.getValue());
        return cal.getTime();
        ]]></body>
    </method>
