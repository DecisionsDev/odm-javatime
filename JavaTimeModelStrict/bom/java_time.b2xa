  <class>
    <businessName>com.ibm.odm.time.Month</businessName>
    <executionName>java.time.Month</executionName>
    <extenderName>com.ibm.ia.rules.model.extender.MonthExtender</extenderName>
    <method>
        <name>java.util.Date</name>
        <parameter type="com.ibm.odm.time.Month"/>
        <body language="arl"><![CDATA[
        java.util.Calendar cal = java.util.Calendar.getInstance(java.util.TimeZone.getTimeZone("UTC"));
        cal.clear();
        cal.set(java.util.Calendar.MONTH, month.getValue() - 1);
        return cal.getTime();
        ]]></body>
