  <class>
    <businessName>com.ibm.odm.time.SimpleDate</businessName>
    <executionName>java.time.LocalDate</executionName>
    <extenderName>com.ibm.ia.rules.model.extender.LocalDateExtender</extenderName>
    <method>
        <name>com.ibm.odm.time.SimpleDate</name>
        <parameter type="long"/>
        <body language="arl"><![CDATA[
        java.util.Calendar calendar = java.util.Calendar.getInstance(java.util.TimeZone.getTimeZone("UTC"));
        calendar.clear();
        calendar.setTimeInMillis(value);
        return java.time.LocalDate.of(
            calendar.get(java.util.Calendar.YEAR), 
            calendar.get(java.util.Calendar.MONTH) + 1, 
            calendar.get(java.util.Calendar.DAY_OF_MONTH));
        ]]></body>
    </method>
    <method>
        <name>java.util.Date</name>
        <parameter type="com.ibm.odm.time.SimpleDate"/>
        <body language="arl"><![CDATA[
        java.util.Calendar cal = java.util.Calendar.getInstance(java.util.TimeZone.getTimeZone("UTC"));
        cal.clear();
        cal.set(java.util.Calendar.YEAR, date.getYear());
        cal.set(java.util.Calendar.MONTH, date.getMonthValue() - 1);
        cal.set(java.util.Calendar.DAY_OF_MONTH, date.getDayOfMonth());
        return cal.getTime();
        ]]></body>
    </method>
  </class>

  <class>
    <businessName>com.ibm.odm.time.Date</businessName>
    <executionName>java.time.ZonedDateTime</executionName>
    <extenderName>com.ibm.ia.rules.model.extender8.TimePoint8Extender</extenderName>
    <method>
        <name>com.ibm.odm.time.Date</name>
        <parameter type="long"/>
        <body language="arl"><![CDATA[
        java.util.Calendar calendar = java.util.Calendar.getInstance(java.util.TimeZone.getTimeZone("UTC"));
        calendar.clear();
        calendar.setTimeInMillis(value);
        return com.ibm.ia.rules.model.extender8.TimePoint8Extender.create(
            calendar.get(java.util.Calendar.YEAR), 
            calendar.get(java.util.Calendar.MONTH) + 1, 
            calendar.get(java.util.Calendar.DAY_OF_MONTH),
            calendar.get(java.util.Calendar.HOUR_OF_DAY),
            calendar.get(java.util.Calendar.MINUTE),
            calendar.get(java.util.Calendar.SECOND));
        ]]></body>
    </method>
    <method>
        <name>java.util.Date</name>
        <parameter type="com.ibm.odm.time.Date"/>
        <body language="arl"><![CDATA[
        return com.ibm.ia.rules.model.extender.TimePointExtender.toJavaUtilDate(timePoint);
        ]]></body>
    </method>
  </class>

