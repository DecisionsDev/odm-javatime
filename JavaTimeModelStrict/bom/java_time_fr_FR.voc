#
# com.ibm.ia.TimePeriod
#

# A time period is defined by a start time and an end time and includes
# all time points that are later than or at the same instant as the
# start time and earlier than the end time. Particular examples for time
# periods are the calendar year 2015, the calendar month June 2015, and
# the calendar day June 10, 2015.

com.ibm.ia.TimePeriod#label = p\u00E9riode de temps

# The following operation creates a time period for the given start and
# end time. These time points are indicated by the placeholders {0} and
# {1}, which must not be translated and which may be filled by any
# expression of type com.ibm.odm.time.Date. This results in examples
# such as "the period between the departure time of the flight and the
# arrival time of the flight". The term {period} is part of the
# operator name and needs to be translated.

com.ibm.ia.TimePeriod.create(com.ibm.odm.time.Date,com.ibm.odm.time.Date)#sentence.navigation = {p\u00E9riode} entre {0} et {1}
com.ibm.ia.TimePeriod.create(com.ibm.odm.time.Date,com.ibm.odm.time.Date)#documentation = D\u00E9finit une p\u00E9riode de temps pour laquelle l'heure de d\u00E9but et l'heure de fin sont sp\u00E9cifi\u00E9es.

# The following four operations return the calendar year, the calendar
# month, the calendar week, and the calendar day that contain a given
# time point. The time point is indicated by the placeholder {0} which
# must not be translated and which may be filled by any expression of
# type com.ibm.odm.time.Date. The result is an expression of type
# com.ibm.ia.TimePeriod such as "the calendar day of the departure
# time of the flight".

com.ibm.ia.TimePeriod.asYear(com.ibm.odm.time.Date)#sentence.navigation = l'ann\u00E9e calendaire {0, PARTITIVE_ARTICLE}
com.ibm.ia.TimePeriod.asYear(com.ibm.odm.time.Date)#documentation = Renvoie l'ann\u00E9e calendaire qui contient le point de temps sp\u00E9cifi\u00E9.
com.ibm.ia.TimePeriod.asMonth(com.ibm.odm.time.Date)#sentence.navigation = le mois calendaire {0, PARTITIVE_ARTICLE}
com.ibm.ia.TimePeriod.asMonth(com.ibm.odm.time.Date)#documentation = Renvoie le mois calendaire qui contient le point de temps sp\u00E9cifi\u00E9.
com.ibm.ia.TimePeriod.asWeek(com.ibm.odm.time.Date)#sentence.navigation = la semaine calendaire {0, PARTITIVE_ARTICLE}
com.ibm.ia.TimePeriod.asWeek(com.ibm.odm.time.Date)#documentation = Renvoie la semaine calendaire qui contient le point de temps sp\u00E9cifi\u00E9.
com.ibm.ia.TimePeriod.asDay(com.ibm.odm.time.Date)#sentence.navigation = le jour calendaire {0, PARTITIVE_ARTICLE}
com.ibm.ia.TimePeriod.asDay(com.ibm.odm.time.Date)#documentation = Renvoie le jour calendaire qui contient le point de temps sp\u00E9cifi\u00E9.

# The following operations return the time periods that contain a given
# time point and that correspond to an hour, a minute, or a second
# during the time of day.  The time point is indicated by the
# placeholder {0} which must not be translated and which may be filled
# by any expression of type com.ibm.odm.time.Date. The result is an
# expression of type com.ibm.ia.TimePeriod such as "the hour of the
# departure time of the flight".

com.ibm.ia.TimePeriod.asHour(com.ibm.odm.time.Date)#sentence.navigation = {heure} {0, PARTITIVE_ARTICLE}
com.ibm.ia.TimePeriod.asHour(com.ibm.odm.time.Date)#documentation = Renvoie l'heure qui contient le point de temps sp\u00E9cifi\u00E9.
com.ibm.ia.TimePeriod.asMinute(com.ibm.odm.time.Date)#sentence.navigation = {minute} {0, PARTITIVE_ARTICLE}
com.ibm.ia.TimePeriod.asMinute(com.ibm.odm.time.Date)#documentation = Renvoie la minute qui contient le point de temps sp\u00E9cifi\u00E9.
com.ibm.ia.TimePeriod.asSecond(com.ibm.odm.time.Date)#sentence.navigation = {seconde} {0, PARTITIVE_ARTICLE}
com.ibm.ia.TimePeriod.asSecond(com.ibm.odm.time.Date)#documentation = Renvoie la seconde qui contient le point de temps sp\u00E9cifi\u00E9.

# The following operations access the start and the end times of a
# time period. The time period is indicated by the placeholder {this},
# which must not be translated and which may be filled by any
# expression of type com.ibm.ia.TimePeriod. The result is an
# expression of type com.ibm.odm.time.Date such as "the start time of
# the trip period". The terms {start} and {end} are parts of the
# operator names and must be translated.

com.ibm.ia.TimePeriod.getStartTime()#sentence.navigation = {d\u00E9but} {this, PARTITIVE_ARTICLE}
com.ibm.ia.TimePeriod.getStartTime()#documentation = Renvoie la date de d\u00E9but de la p\u00E9riode de temps.
com.ibm.ia.TimePeriod.getEndTime()#sentence.navigation =  {fin} {this, PARTITIVE_ARTICLE}
com.ibm.ia.TimePeriod.getEndTime()#documentation =  Renvoie la date de fin de la p\u00E9riode de temps.

# The following four operations determine a time point that proceeds or
# succeeds a given time period by a given duration. The time period is
# indicated by the placeholder {this}, which must not be translated and
# which may be filled by any expression of type
# com.ibm.ia.TimePeriod. The duration is indicated by the placeholder
# {0} which may be filled by any expression of type com.ibm.ia.CalendarDuration.
# This results in expressions of type com.ibm.odm.time.Date such as "30
# minutes after the meeting period".

#\u00A0com.ibm.ia.TimePeriod.timeBefore(com.ibm.ia.CalendarDuration)#sentence.navigation = {0} avant {this}
#\u00A0com.ibm.ia.TimePeriod.timeBefore(com.ibm.ia.CalendarDuration)#documentation = D\u00E9termine un point de temps en soustrayant une dur\u00E9e calendaire \u00E0 partir du d\u00E9but de la p\u00E9riode de temps.
#\u00A0com.ibm.ia.TimePeriod.timeAfter(com.ibm.ia.CalendarDuration)#sentence.navigation = {0} apr\u00E8s {this}
#\u00A0com.ibm.ia.TimePeriod.timeAfter(com.ibm.ia.CalendarDuration)#documentation = D\u00E9termine un point de temps en ajoutant une dur\u00E9e calendaire \u00E0 partir du d\u00E9but de la p\u00E9riode de temps.

# The following four operations determine a time period of a given
# duration that proceeds or succeeds another time period.  The time
# period is indicated by the placeholder {this}, which must not be
# translated and which may be filled by any expression of type
# com.ibm.ia.TimePeriod. The duration is indicated by the placeholder
# {0} which may be filled by any expression of type com.ibm.ia.CalendarDuration.
# This results in expressions of type com.ibm.ia.TimePeriod such as "the
# period of 30 minutes after the meeting period". The term {period} is
# part of the opeartor name and needs to be translated.

com.ibm.ia.TimePeriod.periodBefore(com.ibm.ia.CalendarDuration)#sentence.navigation = {p\u00E9riode} {0, PARTITIVE_ARTICLE} avant {this}
com.ibm.ia.TimePeriod.periodBefore(com.ibm.ia.CalendarDuration)#documentation = D\u00E9finit une p\u00E9riode de temps avec la dur\u00E9e calendaire sp\u00E9cifi\u00E9e qui se termine au d\u00E9but d'une autre p\u00E9riode de temps.
com.ibm.ia.TimePeriod.periodAfter(com.ibm.ia.CalendarDuration)#sentence.navigation = {p\u00E9riode} {0, PARTITIVE_ARTICLE} apr\u00E8s {this}
com.ibm.ia.TimePeriod.periodAfter(com.ibm.ia.CalendarDuration)#documentation = D\u00E9finit une p\u00E9riode de temps avec la dur\u00E9e calendaire sp\u00E9cifi\u00E9e qui commence \u00E0 la fin d'une autre p\u00E9riode de temps.

# The following five operations determine whether a time period is
# after, before, includes, starts at or ends at a time point. The time
# period is indicated by the placeholder {this} which may be filled by
# any expression of type com.ibm.ia.TimePeriod and the time point is
# indicated by the placeholder {0} which may be filled by any expression
# of type com.ibm.odm.time.Date. This results in expressions such as
# "the trip period includes the purchase event".

com.ibm.ia.TimePeriod.after(com.ibm.odm.time.Date)#sentence.navigation = {this} est apr\u00E8s {0}
com.ibm.ia.TimePeriod.after(com.ibm.odm.time.Date)#documentation = V\u00E9rifie si la p\u00E9riode de temps est apr\u00E8s le point de temps sp\u00E9cifi\u00E9.
com.ibm.ia.TimePeriod.before(com.ibm.odm.time.Date)#sentence.navigation = {this} est avant {0}
com.ibm.ia.TimePeriod.before(com.ibm.odm.time.Date)#documentation = V\u00E9rifie si la p\u00E9riode de temps est avant le point de temps sp\u00E9cifi\u00E9.
com.ibm.ia.TimePeriod.contains(com.ibm.odm.time.Date)#sentence.navigation = {this} inclut {0}
com.ibm.ia.TimePeriod.contains(com.ibm.odm.time.Date)#documentation = V\u00E9rifie si la p\u00E9riode de temps inclut le point de temps sp\u00E9cifi\u00E9.
com.ibm.ia.TimePeriod.startsAt(com.ibm.odm.time.Date)#sentence.navigation = {this} commence au m\u00EAme moment que {0}
com.ibm.ia.TimePeriod.startsAt(com.ibm.odm.time.Date)#documentation = V\u00E9rifie si la p\u00E9riode de temps d\u00E9marre au point de temps sp\u00E9cifi\u00E9.
com.ibm.ia.TimePeriod.endsAt(com.ibm.odm.time.Date)#sentence.navigation = {this} se termine au m\u00EAme moment que {0}
com.ibm.ia.TimePeriod.endsAt(com.ibm.odm.time.Date)#documentation = V\u00E9rifie si la p\u00E9riode de temps se termine au point de temps sp\u00E9cifi\u00E9.

# The following operation determines whether two time periods start and
# end at the same instants of time. These time periods are indicated by
# the placeholders {this} and {0}, which must not be translated and
# which may be filled by any expression of type
# com.ibm.ia.TimePeriod. This results into expressions such as "the
# meeting period is during the same time as the period of 2 hours after
# June 6, 2015 12:00:00 PM".

com.ibm.ia.TimePeriod.equalSeconds(com.ibm.ia.TimePeriod)#sentence.navigation = {this} est pendant le m\u00EAme temps que {0}
com.ibm.ia.TimePeriod.equalSeconds(com.ibm.ia.TimePeriod)#documentation = V\u00E9rifie si deux p\u00E9riodes de temps d\u00E9marrent et se terminent en m\u00EAme temps.

# The following three operations determine whether a time period is
# after, before, or overlaps with another time period. These time
# periods are indicated by the placeholders {this} and {0}, which must
# not be translated and which may be filled by any expression of type
# com.ibm.ia.TimePeriod. This results into expressions such as "the
# meeting period overlaps with the education session".

com.ibm.ia.TimePeriod.after(com.ibm.ia.TimePeriod)#sentence.navigation = {this} est apr\u00E8s {0}
com.ibm.ia.TimePeriod.after(com.ibm.ia.TimePeriod)#documentation = V\u00E9rifie si la p\u00E9riode de temps est apr\u00E8s la fin de l'autre p\u00E9riode de temps.
com.ibm.ia.TimePeriod.before(com.ibm.ia.TimePeriod)#sentence.navigation = {this} est avant {0}
com.ibm.ia.TimePeriod.before(com.ibm.ia.TimePeriod)#documentation = V\u00E9rifie si la p\u00E9riode de temps est avant le d\u00E9but de l'autre p\u00E9riode de temps.
com.ibm.ia.TimePeriod.overlaps(com.ibm.ia.TimePeriod)#sentence.navigation = {this} chevauche {0}
com.ibm.ia.TimePeriod.overlaps(com.ibm.ia.TimePeriod)#documentation = V\u00E9rifie si la p\u00E9riode chevauche l'autre p\u00E9riode de temps.

# The following four operations determine whether a time period is
# longer or shorter than a calendar duration. The time period is
# indicated by the placeholder {this} which may be filled by any
# expression of type com.ibm.ia.TimePeriod. The calendar duration is
# indicated by the placeholder {0} which may be filled by any expression
# of type com.ibm.ia.CalendarDuration. This results into expressions
# such as "the trip period is longer than 2 weeks".  The placeholders
# must not be translated.

com.ibm.ia.TimePeriod.longer(com.ibm.ia.CalendarDuration)#sentence.navigation = {this} est plus long(ue) que {0}
com.ibm.ia.TimePeriod.longer(com.ibm.ia.CalendarDuration)#documentation = V\u00E9rifie si la p\u00E9riode de temps est plus longue que la dur\u00E9e calendaire sp\u00E9cifi\u00E9e.
com.ibm.ia.TimePeriod.longerOrEquals(com.ibm.ia.CalendarDuration)#sentence.navigation = {this} est plus long(ue) ou \u00E9gal(e) que {0}
com.ibm.ia.TimePeriod.longerOrEquals(com.ibm.ia.CalendarDuration)#documentation = V\u00E9rifie si la p\u00E9riode de temps est plus longue ou \u00E9gale \u00E0 la dur\u00E9e calendaire sp\u00E9cifi\u00E9e.
com.ibm.ia.TimePeriod.shorter(com.ibm.ia.CalendarDuration)#sentence.navigation = {this} est plus court(e) que {0}
com.ibm.ia.TimePeriod.shorter(com.ibm.ia.CalendarDuration)#documentation = V\u00E9rifie si la p\u00E9riode de temps est plus courte que la dur\u00E9e calendaire sp\u00E9cifi\u00E9e.
com.ibm.ia.TimePeriod.shorterOrEquals(com.ibm.ia.CalendarDuration)#sentence.navigation = {this} est plus court(e) ou \u00E9gal(e) que {0}
com.ibm.ia.TimePeriod.shorterOrEquals(com.ibm.ia.CalendarDuration)#documentation = V\u00E9rifie si la p\u00E9riode de temps est plus courte ou \u00E9gale \u00E0 la dur\u00E9e calendaire sp\u00E9cifi\u00E9e.

# The following four operations determine whether a time period is
# longer or shorter than another time period. These time
# periods are indicated by the placeholders {this} and {0}, which must
# not be translated and which may be filled by any expression of type
