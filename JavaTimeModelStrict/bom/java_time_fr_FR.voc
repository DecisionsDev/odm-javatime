#
# com.ibm.ia.StringProvider
#

# The type com.ibm.ia.StringProvider provides operations for
# concatenating string representations of objects. The operations are
# expressed by a plus-symbol and thus do not need any translation. It is
# thus sufficient to translate the documentation.

com.ibm.ia.StringProvider.concat(java.lang.String,com.ibm.ia.StringProvider)#sentence.navigation = {0} + {1}
com.ibm.ia.StringProvider.concat(java.lang.String,com.ibm.ia.StringProvider)#sentence.navigation.precedence = 1-1:left:100
com.ibm.ia.StringProvider.concat(java.lang.String,com.ibm.ia.StringProvider)#documentation = Concat\u00E8ne une cha\u00EEne de caract\u00E8res et la repr\u00E9sentation d'une cha\u00EEne de caract\u00E8res d'un objet.
com.ibm.ia.StringProvider.concat(com.ibm.ia.StringProvider,java.lang.String)#sentence.navigation = {0} + {1}
com.ibm.ia.StringProvider.concat(com.ibm.ia.StringProvider,java.lang.String)#sentence.navigation.precedence = 1-1:left:100
com.ibm.ia.StringProvider.concat(com.ibm.ia.StringProvider,java.lang.String)#documentation = Concat\u00E8ne la repr\u00E9sentation d'une cha\u00EEne de caract\u00E8res d'un objet et une cha\u00EEne de caract\u00E8res.

#
# com.ibm.ia.CalendarDuration
#

# Expressions of type com.ibm.ia.CalendarDuration represent durations
# in calendar units such as years, months, weeks, days, as well as time
# units, such as hours, minutes, and seconds. Calendar durations
# correspond to nominal durations in the ISO 8601 standard.

com.ibm.ia.CalendarDuration#label = dur\u00E9e calendaire

# The following two operations determine a time point that proceeds or
# succeeds a given time point by a given calendar duration. The duration
# is indicated by the placeholder {this} and the time point is indicated
# by the placeholder {0}. The placeholder {this} may be filled by any
# expression of type com.ibm.ia.CalendarDuration such as "1 month 5
# days 10 hours" and the placeholder {0} may be filled by any expression
# of type com.ibm.odm.time.Date such as "the start of the trip". This
# results in expressions such as ""1 month 5 days 10 hours break before
# the start of the trip".

com.ibm.ia.CalendarDuration.timeBefore(com.ibm.odm.time.Date)#sentence.navigation = {0} - {this}
com.ibm.ia.CalendarDuration.timeBefore(com.ibm.odm.time.Date)#sentence.navigation.precedence = 1-1:left:100
com.ibm.ia.CalendarDuration.timeBefore(com.ibm.odm.time.Date)#documentation = D\u00E9termine un point de temps en soustrayant une dur\u00E9e calendaire \u00E0 partir d'un point de temps.

com.ibm.ia.CalendarDuration.timeAfter(com.ibm.odm.time.Date)#sentence.navigation = {0} + {this}
com.ibm.ia.CalendarDuration.timeAfter(com.ibm.odm.time.Date)#sentence.navigation.precedence = 1-1:left:100
com.ibm.ia.CalendarDuration.timeAfter(com.ibm.odm.time.Date)#documentation = D\u00E9termine un point de temps en ajoutant une dur\u00E9e calendaire \u00E0 partir d'un point de temps.

# The following two operations determine a time period of a given
# calendar duration that proceeds or succeeds a given time point, but
# that does not include this time point. The duration is indicated by
# the placeholder {this} and the time point is indicated by the
# placeholder {0}. The placeholder {this} may be filled by any
# expression of type com.ibm.ia.CalendarDuration such as "1 week" and
# the placeholder {0} may be filled by any expression of type
# com.ibm.odm.time.Date such as "the start of the trip". This results in
# expressions such as "the period of 1 week before the start of the
# trip". The term {period} is part of the operator name and needs to
# be translated. The placeholders {this} and {0} must not be
# translated.

com.ibm.ia.CalendarDuration.periodBefore(com.ibm.odm.time.Date)#sentence.navigation = {p\u00E9riode} {this, PARTITIVE_ARTICLE} se terminant avant {0}
com.ibm.ia.CalendarDuration.periodBefore(com.ibm.odm.time.Date)#documentation = D\u00E9finit une p\u00E9riode de la dur\u00E9e calendaire pr\u00E9cis\u00E9e qui se termine au point de temps sp\u00E9cifi\u00E9, mais ne comprend pas ce point de temps.
com.ibm.ia.CalendarDuration.periodAfter(com.ibm.odm.time.Date)#sentence.navigation = {p\u00E9riode} {this, PARTITIVE_ARTICLE} commen\u00E7ant apr\u00E8s {0}
com.ibm.ia.CalendarDuration.periodAfter(com.ibm.odm.time.Date)#documentation = D\u00E9finit une p\u00E9riode de la dur\u00E9e calendaire sp\u00E9cifi\u00E9e qui commence juste apr\u00E8s le point de temps sp\u00E9cifi\u00E9.

# The following two operations determine a time period of a given
# calendar duration that proceeds or succeeds a given time point and
# that include this time point. An example is "the period of 1 day
# starting at the end of the trip". The term {period} is part of the
# operator name and needs to be translated. The placeholders {this}
# and {0} must not be translated.

com.ibm.ia.CalendarDuration.periodEndingAt(com.ibm.odm.time.Date)#sentence.navigation = {p\u00E9riode} {this, PARTITIVE_ARTICLE} se terminant {0}
com.ibm.ia.CalendarDuration.periodEndingAt(com.ibm.odm.time.Date)#documentation = D\u00E9finit une p\u00E9riode de la dur\u00E9e sp\u00E9cifi\u00E9e qui se termine \u00E0 un point de temps sp\u00E9cifi\u00E9 et comprend ce point de temps.
com.ibm.ia.CalendarDuration.periodStartingAt(com.ibm.odm.time.Date)#sentence.navigation = {p\u00E9riode} {this, PARTITIVE_ARTICLE} commen\u00E7ant {0}
com.ibm.ia.CalendarDuration.periodStartingAt(com.ibm.odm.time.Date)#documentation = D\u00E9finit une p\u00E9riode de la dur\u00E9e sp\u00E9cifi\u00E9e qui commence au point de temps sp\u00E9cifi\u00E9.

#
# com.ibm.odm.time.Date
#

# Expressions of type com.ibm.odm.time.Date represent time points which
# are characterized by a time instant and a time zone. An example is
# June 10, 2015 2:15:30 AM in time zone Pacific/Midway. Its string
# representation is 2015-06-10T02:15:30-11:00[Pacific/Midway].

com.ibm.odm.time.Date#label = date & heure

com.ibm.odm.time.Date.after(com.ibm.odm.time.Date)#sentence.navigation = {this} est apr\u00E8s {0}
com.ibm.odm.time.Date.after(com.ibm.odm.time.Date)#documentation = Teste si la premi\u00E8re date est apr\u00E8s la seconde date
com.ibm.odm.time.Date.after(com.ibm.odm.time.Date)#predicate.format = > {0}
com.ibm.odm.time.Date.after(com.ibm.odm.time.Date)#predicate.description = >
com.ibm.odm.time.Date.after(com.ibm.odm.time.Date)#predicate.group = 1

com.ibm.odm.time.Date.afterOrEquals(com.ibm.odm.time.Date)#sentence.navigation = {this} est apr\u00E8s ou \u00E9gal \u00E0 {0}
com.ibm.odm.time.Date.afterOrEquals(com.ibm.odm.time.Date)#documentation = Teste si la premi\u00E8re date est apr\u00E8s ou \u00E9gale \u00E0 la seconde date

com.ibm.odm.time.Date.before(com.ibm.odm.time.Date)#sentence.navigation = {this} est avant {0}
com.ibm.odm.time.Date.before(com.ibm.odm.time.Date)#documentation = Teste si la premi\u00E8re date est avant la seconde date
com.ibm.odm.time.Date.beforeOrEquals(com.ibm.odm.time.Date)#sentence.navigation = {this} est avant ou \u00E9gal \u00E0 {0}
com.ibm.odm.time.Date.beforeOrEquals(com.ibm.odm.time.Date)#documentation = Teste si la premi\u00E8re date est avant ou \u00E9gale \u00E0 la seconde date

com.ibm.odm.time.Date.isAtDate(com.ibm.odm.time.Date)#sentence.navigation = {this} est \u00E0 la m\u00EAme date que {0}
com.ibm.odm.time.Date.isAtDate(com.ibm.odm.time.Date)#documentation = Teste si les deux dates tombent le m\u00EAme jour. L'heure n'est pas prise en compte
com.ibm.odm.time.Date.isAtDayOfWeek(com.ibm.odm.time.DayOfWeek)#sentence.navigation = {this} est {0}
com.ibm.odm.time.Date.isAtDayOfWeek(com.ibm.odm.time.DayOfWeek)#documentation = Teste si la date tombe le jour sp\u00E9cifi\u00E9
com.ibm.odm.time.Date.isAtDayTime(com.ibm.odm.time.DayOfWeek,com.ibm.odm.time.Time)#sentence.navigation = {this} est {0} \u00E0 {1}
com.ibm.odm.time.Date.isAtDayTime(com.ibm.odm.time.DayOfWeek,com.ibm.odm.time.Time)#documentation = Teste si la date tombe le jour et l'heure sp\u00E9cifi\u00E9s
com.ibm.odm.time.Date.isAtMonth(com.ibm.odm.time.Month)#sentence.navigation = {this} est au m\u00EAme mois que {0}
com.ibm.odm.time.Date.isAtMonth(com.ibm.odm.time.Month)#documentation = Teste si la date tombe le mois sp\u00E9cifi\u00E9
com.ibm.odm.time.Date.isAtMonthYear(com.ibm.odm.time.Month,com.ibm.odm.time.Year)#sentence.navigation = {this} est en {0} {1}
com.ibm.odm.time.Date.isAtMonthYear(com.ibm.odm.time.Month,com.ibm.odm.time.Year)#documentation = Teste si la date tombe le mois et l'ann\u00E9e sp\u00E9cifi\u00E9s
com.ibm.odm.time.Date.isAtTime(com.ibm.odm.time.Time)#sentence.navigation = {this} est \u00E0 la m\u00EAme heure que {0}
com.ibm.odm.time.Date.isAtTime(com.ibm.odm.time.Time)#documentation = Teste si la date tombe l'heure sp\u00E9cifi\u00E9e
com.ibm.odm.time.Date.isOnDate(com.ibm.odm.time.SimpleDate)#sentence.navigation = {this} est le {0}
com.ibm.odm.time.Date.isOnDate(com.ibm.odm.time.SimpleDate)#documentation = Tests si la date tombe le jour de l'ann\u00E9e sp\u00E9cifi\u00E9s.
com.ibm.odm.time.Date.isAtYear(com.ibm.odm.time.Year)#sentence.navigation = {this} est en {0}
com.ibm.odm.time.Date.isAtYear(com.ibm.odm.time.Year)#documentation = Teste si la date tombe l'ann\u00E9e sp\u00E9cifi\u00E9e

com.ibm.odm.time.Date.isBetweenEE(com.ibm.odm.time.Date,com.ibm.odm.time.Date)#sentence.navigation = {this} est apr\u00E8s {0} et avant {1}
com.ibm.odm.time.Date.isBetweenEE(com.ibm.odm.time.Date,com.ibm.odm.time.Date)#documentation = Teste si la premi\u00E8re date est apr\u00E8s la deuxi\u00E8me date et avant la troisi\u00E8me
com.ibm.odm.time.Date.isBetweenEE(com.ibm.odm.time.Date,com.ibm.odm.time.Date)#predicate.format = ]{0},{1}[
com.ibm.odm.time.Date.isBetweenEE(com.ibm.odm.time.Date,com.ibm.odm.time.Date)#predicate.description = ]..[
com.ibm.odm.time.Date.isBetweenEE(com.ibm.odm.time.Date,com.ibm.odm.time.Date)#predicate.group = 2

com.ibm.odm.time.Date.isBetweenEI(com.ibm.odm.time.Date,com.ibm.odm.time.Date)#sentence.navigation = {this} est apr\u00E8s {0} et \u00E0 ou avant {1}
com.ibm.odm.time.Date.isBetweenEI(com.ibm.odm.time.Date,com.ibm.odm.time.Date)#documentation = Teste si la premi\u00E8re date est apr\u00E8s la deuxi\u00E8me date et avant ou \u00E9gale \u00E0 la troisi\u00E8me
com.ibm.odm.time.Date.isBetweenIE(com.ibm.odm.time.Date,com.ibm.odm.time.Date)#sentence.navigation = {this} est \u00E0 ou apr\u00E8s {0} et avant {1}
com.ibm.odm.time.Date.isBetweenIE(com.ibm.odm.time.Date,com.ibm.odm.time.Date)#documentation = Teste si la premi\u00E8re date est apr\u00E8s ou \u00E9gale \u00E0 la deuxi\u00E8me date et avant la troisi\u00E8me
com.ibm.odm.time.Date.isBetweenII(com.ibm.odm.time.Date,com.ibm.odm.time.Date)#sentence.navigation = {this} est \u00E0 ou apr\u00E8s {0} et \u00E0 ou avant {1}
com.ibm.odm.time.Date.isBetweenII(com.ibm.odm.time.Date,com.ibm.odm.time.Date)#documentation = Teste si la premi\u00E8re date est apr\u00E8s ou \u00E9gale \u00E0 la deuxi\u00E8me date et avant ou \u00E9gale \u00E0 la troisi\u00E8me

# A time point is represented by six components, namely the year, the
# month of year, the day of month, the hour of day, the minute of hour,
# the second of minute. The following operations are accessing those
# components of a time point. Furthermore, there is an operation for
# accessing the time of day and the day of week of a time point. The
# time point is indicated by the placeholder {this}, which must not be
# translated and which may be filled by any expression of type
# com.ibm.odm.time.Date such as "the departure time of the flight". This
# results in expressions such as "the time of day of the departure time
# of the flight".

com.ibm.odm.time.Date.getGregorianYear()#sentence.navigation = {ann\u00E9e} {this, PARTITIVE_ARTICLE}
com.ibm.odm.time.Date.getGregorianYear()#documentation = Retourne l'ann\u00E9e du point de temps sp\u00E9cifi\u00E9.
com.ibm.odm.time.Date.getMonthOfYear()#sentence.navigation = {mois de l'ann\u00E9e} {this, PARTITIVE_ARTICLE}
com.ibm.odm.time.Date.getMonthOfYear()#documentation = Retourne le mois, allant de janvier \u00E0 d\u00E9cembre.
com.ibm.odm.time.Date.getDayOfMonth()#sentence.navigation = {jour du mois} {this, PARTITIVE_ARTICLE}
com.ibm.odm.time.Date.getDayOfMonth()#documentation = Retourne le jour dans le mois, allant de 1 \u00E0 31.
com.ibm.odm.time.Date.getDayTime()#sentence.navigation = {horaire} {this, PARTITIVE_ARTICLE}
com.ibm.odm.time.Date.getDayTime()#documentation = Renvoie l'heure de la journ\u00E9e, allant de 0:00:00 \u00E0 23:59:59.
com.ibm.odm.time.Date.toLocalDate()#sentence.navigation = {date} {this, PARTITIVE_ARTICLE}
com.ibm.odm.time.Date.toLocalDate()#documentation = Returns la date dans le calendrier Gregorien.
com.ibm.odm.time.Date.getDayOfWeek()#sentence.navigation = {jour de la semaine} {this, PARTITIVE_ARTICLE}
com.ibm.odm.time.Date.getDayOfWeek()#documentation = Renvoie le jour de la semaine, allant du dimanche au samedi.
com.ibm.odm.time.Date.getHourOfDay()#sentence.navigation = {heure du jour} {this, PARTITIVE_ARTICLE}
com.ibm.odm.time.Date.getHourOfDay()#documentation = Renvoie l'heure de la journ\u00E9e, allant de 0 \u00E0 23.
com.ibm.odm.time.Date.getMinuteOfHour()#sentence.navigation = {minute de l'heure} {this, PARTITIVE_ARTICLE}
com.ibm.odm.time.Date.getMinuteOfHour()#documentation = Retourne la minute d'une heure, allant de 0 \u00E0 59.
com.ibm.odm.time.Date.getSecondOfMinute()#sentence.navigation = {seconde de la minute} {this, PARTITIVE_ARTICLE}
com.ibm.odm.time.Date.getSecondOfMinute()#documentation = Retourne la seconde d'une minute, allant de 0 \u00E0 59.

# The following operations convert a time point to the local time in
# another time zone. This time zone is specified by a name or is equal
# the time zone of another time point. The first time point is
# indicated by the placeholder {this} which may be filled by any
# expression of type com.ibm.odm.time.Date such as "the departure time
# of the flight". The time zone information is indicated by the
# placeholder {0}, which may be filled by the name of a time zone in
# the IANA Time Zone Database such as "Pacific/Midway" or by any
# expression of type com.ibm.odm.time.Date. This results in expressions
# such as "the local time of the departure time of the flight in
# "Pacific/Midway"". The term {local} is part of the operator name and
# needs to be translated. The placeholders {this} and {0} must not be
# translated.

com.ibm.odm.time.Date.inZone(string)#sentence.navigation = {heure locale} {this, PARTITIVE_ARTICLE} en {0}
com.ibm.odm.time.Date.inZone(string)#documentation = Convertit le point de temps sur le fuseau horaire sp\u00E9cifi\u00E9. Le fuseau horaire est bas\u00E9 sur la IANA Time Zone Database.
com.ibm.odm.time.Date.inSameZoneAs(com.ibm.odm.time.Date)#sentence.navigation = {heure locale} {this, PARTITIVE_ARTICLE} dans la zone de {0}
com.ibm.odm.time.Date.inSameZoneAs(com.ibm.odm.time.Date)#documentation = Convertit le premier point de temps au fuseau horaire du deuxi\u00E8me point de temps.

# The following operation determines whether two time points have the same
# instant of time. These time points are indicated by the placeholders
# {this} and {0}, which must not be translated and which may be filled
# by any expression of type com.ibm.odm.time.Date. This results into
# expressions such as "the departure time of the flight is at the same
# time as June 10, 2015 2:15:30 AM UTC-11:00.

com.ibm.odm.time.Date.equalSeconds(com.ibm.odm.time.Date)#sentence.navigation = {this} est en m\u00EAme temps que {0}
com.ibm.odm.time.Date.equalSeconds(com.ibm.odm.time.Date)#documentation = V\u00E9rifie si le premier point de temps est en m\u00EAme temps que le deuxi\u00E8me point dans le temps.

# The following three operations determine whether a time point is
# after, before, or during a time period. The time point is indicated by
# the placeholder {this} which may be filled by any expression of type
# com.ibm.odm.time.Date and the time period is indicated by the
# placeholder {0} which may be filled by any expression of type
# com.ibm.ia.TimePeriod. This results in expressions such as "the
# check in event is during the period of 2 hours before 30 minutes before
# the departure time of the flight".

com.ibm.odm.time.Date.after(com.ibm.ia.TimePeriod)#sentence.navigation = {this} est apr\u00E8s {0}
com.ibm.odm.time.Date.after(com.ibm.ia.TimePeriod)#documentation = V\u00E9rifie si un point de temps est apr\u00E8s une p\u00E9riode de temps.
com.ibm.odm.time.Date.before(com.ibm.ia.TimePeriod)#sentence.navigation = {this} est avant {0}
com.ibm.odm.time.Date.before(com.ibm.ia.TimePeriod)#documentation = V\u00E9rifie si un point de temps est avant une p\u00E9riode de temps.
com.ibm.odm.time.Date.during(com.ibm.ia.TimePeriod)#sentence.navigation = {this} est durant {0}
com.ibm.odm.time.Date.during(com.ibm.ia.TimePeriod)#documentation = V\u00E9rifie si un point de temps est pendant une p\u00E9riode de temps.

# The following seven operations determine whether two time points are in
# the same calendar period or time-of-day period. The time points are
# indicated by the placeholders {this} and {0}. These placeholders must
# not be translated and may be filled by any expression of type
# com.ibm.odm.time.Date such as "the departure time of the flight" and
# "the purchase event". This results in expressions such as "the
# departure time of the flight is on the same calendar day as the
# purchase event". The placeholder {this} and {0} must not be
# translated.

com.ibm.odm.time.Date.haveSameCalendarYear(com.ibm.odm.time.Date)#sentence.navigation = {this} est dans la m\u00EAme ann\u00E9e calendaire que {0}
com.ibm.odm.time.Date.haveSameCalendarYear(com.ibm.odm.time.Date)#documentation = V\u00E9rifie que deux points dans le temps sont dans la m\u00EAme ann\u00E9e calendaire.
com.ibm.odm.time.Date.haveSameCalendarMonth(com.ibm.odm.time.Date)#sentence.navigation = {this} est dans le m\u00EAme mois calendaire que {0}
com.ibm.odm.time.Date.haveSameCalendarMonth(com.ibm.odm.time.Date)#documentation = V\u00E9rifie que deux points dans le temps sont dans le m\u00EAme mois calendaire.
com.ibm.odm.time.Date.haveSameCalendarWeek(com.ibm.odm.time.Date)#sentence.navigation = {this} est dans la m\u00EAme semaine calendaire que {0}
com.ibm.odm.time.Date.haveSameCalendarWeek(com.ibm.odm.time.Date)#documentation = V\u00E9rifie que deux points dans le temps sont dans la m\u00EAme semaine calendaire.
com.ibm.odm.time.Date.haveSameCalendarDay(com.ibm.odm.time.Date)#sentence.navigation = {this} est dans le m\u00EAme jour calendaire que {0}
com.ibm.odm.time.Date.haveSameCalendarDay(com.ibm.odm.time.Date)#documentation = V\u00E9rifie que deux points dans le temps sont dans le m\u00EAme jour calendaire.
com.ibm.odm.time.Date.haveSameHourPeriod(com.ibm.odm.time.Date)#sentence.navigation = {this} est dans la m\u00EAme heure que {0}
com.ibm.odm.time.Date.haveSameHourPeriod(com.ibm.odm.time.Date)#documentation = V\u00E9rifie que deux points dans le temps sont dans la m\u00EAme heure.
com.ibm.odm.time.Date.haveSameMinutePeriod(com.ibm.odm.time.Date)#sentence.navigation = {this} est dans la m\u00EAme minute que {0}
com.ibm.odm.time.Date.haveSameMinutePeriod(com.ibm.odm.time.Date)#documentation = V\u00E9rifie que deux points dans le temps sont dans la m\u00EAme minute.
com.ibm.odm.time.Date.haveSameSecondPeriod(com.ibm.odm.time.Date)#sentence.navigation = {this} est dans la m\u00EAme seconde que {0}
com.ibm.odm.time.Date.haveSameSecondPeriod(com.ibm.odm.time.Date)#documentation = V\u00E9rifie que deux points dans le temps sont dans la m\u00EAme seconde.

# The following four operations determine whether a time point is in the
# period of a specified duration that proceeds or succeeds another time
# point. The two time points are indicated by the placeholders {this}
# and {0} which may be filled by any expression of type
# com.ibm.odm.time.Date. The duration is indicated by the placeholder
# {1} which may be filled by any expression of type com.ibm.ia.CalendarDuration.
# This results in examples such as "the check in event is within 2 hours
# before 30 minutes before the departure time of the flight". The
# placeholders must not be translated.

