<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 http://maven.apache.org/xsd/assembly-2.2.0.xsd">
  <id>distribution</id>
  <formats>
    <format>zip</format>
  </formats>
  <baseDirectory>javatime-compatible-${project.version}</baseDirectory>
  <fileSets>
    <fileSet>
      <directory>${project.basedir}/../JavaTimeModelCompatible/bom</directory>
      <outputDirectory>JavaTimeModelCompatible/bom</outputDirectory>
      <includes>
        <include>java_*</include>
      </includes>
    </fileSet>
    <fileSet>
      <directory>${project.basedir}/../SampleXomCompatible/src</directory>
      <outputDirectory>SampleXomCompatible/src</outputDirectory>
      <includes>
        <include>**/*.java</include>
      </includes>
    </fileSet>
    <fileSet>
      <directory>${project.basedir}/../SampleRulesetCompatible/bom</directory>
      <outputDirectory>SampleRulesetCompatible/bom</outputDirectory>
      <includes>
        <include>model*</include>
      </includes>
    </fileSet>
    <fileSet>
      <directory>${project.basedir}/../SampleRulesetCompatible/deployment</directory>
      <outputDirectory>SampleRulesetCompatible/deployment</outputDirectory>
      <includes>
        <include>*.dop</include>
      </includes>
    </fileSet>
    <fileSet>
      <directory>${project.basedir}/../SampleRulesetCompatible/rules</directory>
      <outputDirectory>SampleRulesetCompatible/rules</outputDirectory>
      <includes>
        <include>*.brl</include>
        <include>*.rfl</include>
        <include>*.var</include>
      </includes>
    </fileSet>
  </fileSets>
    <files>
        <file>
            <source>${project.basedir}/../JavaTimeModelCompatible/.project</source>
            <outputDirectory>JavaTimeModelCompatible</outputDirectory>
        </file>
        <file>
            <source>${project.basedir}/../JavaTimeModelCompatible/.ruleproject</source>
            <outputDirectory>JavaTimeModelCompatible</outputDirectory>
        </file>
        <file>
            <source>${project.basedir}/../SampleXomCompatible/.classpath</source>
            <outputDirectory>SampleXomCompatible</outputDirectory>
        </file>
        <file>
            <source>${project.basedir}/../SampleXomCompatible/.project</source>
            <outputDirectory>SampleXomCompatible</outputDirectory>
        </file>
        <file>
            <source>${project.basedir}/../SampleRulesetCompatible/.project</source>
            <outputDirectory>SampleRulesetCompatible</outputDirectory>
        </file>
        <file>
            <source>${project.basedir}/../SampleRulesetCompatible/.ruleproject</source>
            <outputDirectory>SampleRulesetCompatible</outputDirectory>
        </file>
    </files>
</assembly>
