  <definition><![CDATA[definitions
	set 'birth date' to the birth date of 'the customer'; 
	set 'today' to now;  
if 
	'birth date' is in the same calendar month as today and 'birth date' is on the same calendar day as today 
then 
	print "Today " + the date of today + " is your birthday, happy birthday !!!" ;]]></definition>
