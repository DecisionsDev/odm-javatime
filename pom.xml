<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.ilog.rules.sfactory</groupId>
    <artifactId>rootpom</artifactId>
    <version>9.6.0-SNAPSHOT</version>
  </parent>

  <properties>
      <odm.version>9.6.0-SNAPSHOT</odm.version>
      <junit.version>4.13.2</junit.version>
      <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
      <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>

  <groupId>com.ilog.rules.language</groupId>
  <artifactId>javatime-root</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <profiles>
    <!-- Profile to build only distributions -->
    <profile>
      <id>distribution</id>
      <modules>
        <module>javatime-strict</module>
        <module>javatime-compatible</module>
      </modules>
    </profile>

    <!-- Profile to build only Eclipse plugin -->
    <profile>
      <id>plugin</id>
      <modules>
        <module>eclipse-plugin</module>
      </modules>
    </profile>

    <!-- Profile to build everything (distributions + plugin) -->
    <profile>
      <id>all</id>
      <modules>
        <module>javatime-strict</module>
        <module>javatime-compatible</module>
        <module>eclipse-plugin</module>
      </modules>
    </profile>
  </profiles>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-assembly-plugin</artifactId>
          <version>3.7.1</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.0</version>
          <configuration>
              <release>21</release>
              <source>21</source>
              <target>21</target>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
  
</project>
