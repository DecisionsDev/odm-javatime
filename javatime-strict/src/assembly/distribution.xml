<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 http://maven.apache.org/xsd/assembly-2.2.0.xsd">
  <id>distribution</id>
  <formats>
    <format>zip</format>
  </formats>
  <baseDirectory>javatime-strict-${project.version}</baseDirectory>
  <fileSets>
    <fileSet>
      <directory>${project.basedir}/../JavaTimeModelStrict/bom</directory>
      <outputDirectory>JavaTimeModelStrict/bom</outputDirectory>
      <includes>
        <include>java_*</include>
      </includes>
    </fileSet>
    <fileSet>
      <directory>${project.basedir}/../SampleXomStrict/src</directory>
      <outputDirectory>SampleXomStrict/src</outputDirectory>
      <includes>
        <include>**/*.java</include>
      </includes>
    </fileSet>
    <fileSet>
      <directory>${project.basedir}/../SampleRulesetStrict/bom</directory>
      <outputDirectory>SampleRulesetStrict/bom</outputDirectory>
      <includes>
        <include>model*</include>
      </includes>
    </fileSet>
    <fileSet>
      <directory>${project.basedir}/../SampleRulesetStrict/deployment</directory>
      <outputDirectory>SampleRulesetStrict/deployment</outputDirectory>
      <includes>
        <include>*.dop</include>
      </includes>
    </fileSet>
    <fileSet>
      <directory>${project.basedir}/../SampleRulesetStrict/rules</directory>
      <outputDirectory>SampleRulesetStrict/rules</outputDirectory>
      <includes>
        <include>**/*.brl</include>
        <include>**/*.dta</include>
        <include>**/*.rfl</include>
        <include>**/*.var</include>
        <include>**/.rulepackage</include>
      </includes>
    </fileSet>
  </fileSets>
    <files>
        <file>
            <source>${project.basedir}/../JavaTimeModelStrict/.project</source>
            <outputDirectory>JavaTimeModelStrict</outputDirectory>
        </file>
        <file>
            <source>${project.basedir}/../JavaTimeModelStrict/.ruleproject</source>
            <outputDirectory>JavaTimeModelStrict</outputDirectory>
        </file>
        <file>
            <source>${project.basedir}/../SampleXomStrict/.classpath</source>
            <outputDirectory>SampleXomStrict</outputDirectory>
        </file>
        <file>
            <source>${project.basedir}/../SampleXomStrict/.project</source>
            <outputDirectory>SampleXomStrict</outputDirectory>
        </file>
        <file>
            <source>${project.basedir}/../SampleRulesetStrict/.project</source>
            <outputDirectory>SampleRulesetStrict</outputDirectory>
        </file>
        <file>
            <source>${project.basedir}/../SampleRulesetStrict/.ruleproject</source>
            <outputDirectory>SampleRulesetStrict</outputDirectory>
        </file>
    </files>
</assembly>
