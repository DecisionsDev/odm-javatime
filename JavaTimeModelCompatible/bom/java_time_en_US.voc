#
# com.ibm.ia.StringProvider
#

# The type com.ibm.ia.StringProvider provides operations for
# concatenating string representations of objects. The operations are
# expressed by a plus-symbol and thus do not need any translation. It is
# thus sufficient to translate the documentation.

com.ibm.ia.StringProvider.concat(java.lang.String,com.ibm.ia.StringProvider)#sentence.navigation = {0} + {1}
com.ibm.ia.StringProvider.concat(java.lang.String,com.ibm.ia.StringProvider)#sentence.navigation.precedence = 1-1:left:100
com.ibm.ia.StringProvider.concat(java.lang.String,com.ibm.ia.StringProvider)#documentation = Concatenates a string and the string representation of an object.
com.ibm.ia.StringProvider.concat(com.ibm.ia.StringProvider,java.lang.String)#sentence.navigation = {0} + {1}
com.ibm.ia.StringProvider.concat(com.ibm.ia.StringProvider,java.lang.String)#sentence.navigation.precedence = 1-1:left:100
com.ibm.ia.StringProvider.concat(com.ibm.ia.StringProvider,java.lang.String)#documentation = Concatenates the string representation of an object and a string.

#
# com.ibm.ia.CalendarDuration
#

# Expressions of type com.ibm.ia.CalendarDuration represent durations
# in calendar units such as years, months, weeks, days, as well as time
# units, such as hours, minutes, and seconds. Calendar durations
# correspond to nominal durations in the ISO 8601 standard.

com.ibm.ia.CalendarDuration#label = time.calendar duration

# The following two operations determine a time point that proceeds or
# succeeds a given time point by a given calendar duration. The duration
# is indicated by the placeholder {this} and the time point is indicated
# by the placeholder {0}. The placeholder {this} may be filled by any
# expression of type com.ibm.ia.CalendarDuration such as "1 month 5
# days 10 hours" and the placeholder {0} may be filled by any expression
# of type com.ibm.odm.time.Date such as "the start of the trip". This
# results in expressions such as ""1 month 5 days 10 hours break before
# the start of the trip".

com.ibm.ia.CalendarDuration.timeBefore(com.ibm.odm.time.Date)#sentence.navigation = {0} - {this}
com.ibm.ia.CalendarDuration.timeBefore(com.ibm.odm.time.Date)#sentence.navigation.precedence = 1-1:left:100
com.ibm.ia.CalendarDuration.timeBefore(com.ibm.odm.time.Date)#documentation = Determines a time point by subtracting a calendar duration from a time point.

com.ibm.ia.CalendarDuration.timeAfter(com.ibm.odm.time.Date)#sentence.navigation = {0} + {this}
com.ibm.ia.CalendarDuration.timeAfter(com.ibm.odm.time.Date)#sentence.navigation.precedence = 1-1:left:100
com.ibm.ia.CalendarDuration.timeAfter(com.ibm.odm.time.Date)#documentation = Determines a time point by adding a calendar duration to a time point.

# The following two operations determine a time period of a given
# calendar duration that proceeds or succeeds a given time point, but
# that does not include this time point. The duration is indicated by
# the placeholder {this} and the time point is indicated by the
# placeholder {0}. The placeholder {this} may be filled by any
# expression of type com.ibm.ia.CalendarDuration such as "1 week" and
# the placeholder {0} may be filled by any expression of type
# com.ibm.odm.time.Date such as "the start of the trip". This results in
# expressions such as "the period of 1 week before the start of the
# trip". The term {period} is part of the operator name and needs to
# be translated. The placeholders {this} and {0} must not be
# translated.

com.ibm.ia.CalendarDuration.periodBefore(com.ibm.odm.time.Date)#sentence.navigation = {period} of {this} before {0}
com.ibm.ia.CalendarDuration.periodBefore(com.ibm.odm.time.Date)#documentation = Defines a period of the specified calendar duration that ends at the specified time point, but does not include this time point.
com.ibm.ia.CalendarDuration.periodAfter(com.ibm.odm.time.Date)#sentence.navigation = {period} of {this} after {0}
com.ibm.ia.CalendarDuration.periodAfter(com.ibm.odm.time.Date)#documentation = Defines a period of the specified calendar duration that starts just after the specified time point.

# The following two operations determine a time period of a given
# calendar duration that proceeds or succeeds a given time point and
# that include this time point. An example is "the period of 1 day
# starting at the end of the trip". The term {period} is part of the
# operator name and needs to be translated. The placeholders {this}
# and {0} must not be translated.

com.ibm.ia.CalendarDuration.periodEndingAt(com.ibm.odm.time.Date)#sentence.navigation = {period} of {this} ending at {0}
com.ibm.ia.CalendarDuration.periodEndingAt(com.ibm.odm.time.Date)#documentation = Defines a period of the specified duration that ends at a the specified time point and includes this time point.
com.ibm.ia.CalendarDuration.periodStartingAt(com.ibm.odm.time.Date)#sentence.navigation = {period} of {this} starting at {0}
com.ibm.ia.CalendarDuration.periodStartingAt(com.ibm.odm.time.Date)#documentation = Defines a period of the specified duration that starts at the specified time point.

#
# com.ibm.odm.time.Date
#

# Expressions of type com.ibm.odm.time.Date represent time points which
# are characterized by a time instant and a time zone. An example is
# June 10, 2015 2:15:30 AM in time zone Pacific/Midway. Its string
# representation is 2015-06-10T02:15:30-11:00[Pacific/Midway].

com.ibm.odm.time.Date#label = time.date & time

com.ibm.odm.time.Date.after(com.ibm.odm.time.Date)#sentence.navigation = {this} is after {0}
com.ibm.odm.time.Date.after(com.ibm.odm.time.Date)#documentation = Returns whether the first time point is after the second time point.
com.ibm.odm.time.Date.after(com.ibm.odm.time.Date)#predicate.format = > {0}
com.ibm.odm.time.Date.after(com.ibm.odm.time.Date)#predicate.description = >
com.ibm.odm.time.Date.after(com.ibm.odm.time.Date)#predicate.group = 1

com.ibm.odm.time.Date.afterOrEquals(com.ibm.odm.time.Date)#sentence.navigation = {this} is after or the same as {0}
com.ibm.odm.time.Date.afterOrEquals(com.ibm.odm.time.Date)#documentation = Returns whether the first time point is the same as or after the second time point.

com.ibm.odm.time.Date.before(com.ibm.odm.time.Date)#sentence.navigation = {this} is before {0}
com.ibm.odm.time.Date.before(com.ibm.odm.time.Date)#documentation = Returns whether the first time point is before the second time point.
com.ibm.odm.time.Date.beforeOrEquals(com.ibm.odm.time.Date)#sentence.navigation = {this} is before or the same as {0}
com.ibm.odm.time.Date.beforeOrEquals(com.ibm.odm.time.Date)#documentation = Returns whether the first time point is the same as or before the second time point.

com.ibm.odm.time.Date.isAtDate(com.ibm.odm.time.Date)#sentence.navigation = {this} is on {0}
com.ibm.odm.time.Date.isAtDate(com.ibm.odm.time.Date)#documentation = Returns whether the first and second time points are on the same date.
com.ibm.odm.time.Date.isAtDayOfWeek(com.ibm.odm.time.DayOfWeek)#sentence.navigation = {this} is on {0}
com.ibm.odm.time.Date.isAtDayOfWeek(com.ibm.odm.time.DayOfWeek)#documentation = Returns whether a time point is on a specified day of week.
com.ibm.odm.time.Date.isAtDayTime(com.ibm.odm.time.DayOfWeek,com.ibm.odm.time.Time)#sentence.navigation = {this} is on {0} at {1}
com.ibm.odm.time.Date.isAtDayTime(com.ibm.odm.time.DayOfWeek,com.ibm.odm.time.Time)#documentation = Returns whether a time point is on a specified day of week and at a specified time.
com.ibm.odm.time.Date.isAtMonth(com.ibm.odm.time.Month)#sentence.navigation = {this} is in {0}
com.ibm.odm.time.Date.isAtMonth(com.ibm.odm.time.Month)#documentation = Returns whether a time point is in a specified month.
com.ibm.odm.time.Date.isAtMonthYear(com.ibm.odm.time.Month,com.ibm.odm.time.Year)#sentence.navigation = {this} is in {0} {1}
com.ibm.odm.time.Date.isAtMonthYear(com.ibm.odm.time.Month,com.ibm.odm.time.Year)#documentation = Returns whether a time point is in a specified month and year.
com.ibm.odm.time.Date.isAtTime(com.ibm.odm.time.Time)#sentence.navigation = {this} is at {0}
com.ibm.odm.time.Date.isAtTime(com.ibm.odm.time.Time)#documentation = Returns whether a time point is at a specified time.
com.ibm.odm.time.Date.isOnDate(com.ibm.odm.time.SimpleDate)#sentence.navigation = {this} is on {0}
com.ibm.odm.time.Date.isOnDate(com.ibm.odm.time.SimpleDate)#documentation = Returns whether a time point is on a specified date.
com.ibm.odm.time.Date.isAtYear(com.ibm.odm.time.Year)#sentence.navigation = {this} is in {0}
com.ibm.odm.time.Date.isAtYear(com.ibm.odm.time.Year)#documentation = Returns whether a time point is in a specified year.

com.ibm.odm.time.Date.isBetweenEE(com.ibm.odm.time.Date,com.ibm.odm.time.Date)#sentence.navigation = {this} is after {0} and before {1}
com.ibm.odm.time.Date.isBetweenEE(com.ibm.odm.time.Date,com.ibm.odm.time.Date)#documentation = Returns whether the first time point is after the second time point and before the third time point.
com.ibm.odm.time.Date.isBetweenEE(com.ibm.odm.time.Date,com.ibm.odm.time.Date)#predicate.format = ]{0},{1}[
com.ibm.odm.time.Date.isBetweenEE(com.ibm.odm.time.Date,com.ibm.odm.time.Date)#predicate.description = ]..[
com.ibm.odm.time.Date.isBetweenEE(com.ibm.odm.time.Date,com.ibm.odm.time.Date)#predicate.group = 2

com.ibm.odm.time.Date.isBetweenEI(com.ibm.odm.time.Date,com.ibm.odm.time.Date)#sentence.navigation = {this} is after {0} and on or before {1}
com.ibm.odm.time.Date.isBetweenEI(com.ibm.odm.time.Date,com.ibm.odm.time.Date)#documentation = Returns whether the first time point is after the second time point and the same as or before the third time point.
com.ibm.odm.time.Date.isBetweenIE(com.ibm.odm.time.Date,com.ibm.odm.time.Date)#sentence.navigation = {this} is on or after {0} and before {1}
com.ibm.odm.time.Date.isBetweenIE(com.ibm.odm.time.Date,com.ibm.odm.time.Date)#documentation = Returns whether the first time point is the same as or after the second time point and before the third time point.
com.ibm.odm.time.Date.isBetweenII(com.ibm.odm.time.Date,com.ibm.odm.time.Date)#sentence.navigation = {this} is on or after {0} and on or before {1}
com.ibm.odm.time.Date.isBetweenII(com.ibm.odm.time.Date,com.ibm.odm.time.Date)#documentation = Returns whether the first time point is the same as or after the second time point and the same as or before the third time point.

# A time point is represented by six components, namely the year, the
# month of year, the day of month, the hour of day, the minute of hour,
# the second of minute. The following operations are accessing those
# components of a time point. Furthermore, there is an operation for
# accessing the time of day and the day of week of a time point. The
# time point is indicated by the placeholder {this}, which must not be
# translated and which may be filled by any expression of type
# com.ibm.odm.time.Date such as "the departure time of the flight". This
# results in expressions such as "the time of day of the departure time
# of the flight".

com.ibm.odm.time.Date.getGregorianYear()#sentence.navigation = {year} of {this}
com.ibm.odm.time.Date.getGregorianYear()#documentation = Returns the year of the specified time point.
com.ibm.odm.time.Date.getMonthOfYear()#sentence.navigation = {month} of {this}
com.ibm.odm.time.Date.getMonthOfYear()#documentation = Returns the the month of the specified time point.
com.ibm.odm.time.Date.getDayOfMonth()#sentence.navigation = {day of month} of {this}
com.ibm.odm.time.Date.getDayOfMonth()#documentation = Returns the number of the day in the month, ranging from 1 to 31.
com.ibm.odm.time.Date.getDayTime()#sentence.navigation = {time of day} of {this}
com.ibm.odm.time.Date.getDayTime()#documentation = Returns the time of the day, ranging from 00:00:00 AM to 11:59:59 PM.
com.ibm.odm.time.Date.toLocalDate()#sentence.navigation = {date} of {this}
com.ibm.odm.time.Date.toLocalDate()#documentation = Returns the date in the Gregorian calendar.
com.ibm.odm.time.Date.getDayOfWeek()#sentence.navigation = {day of week} of {this}
com.ibm.odm.time.Date.getDayOfWeek()#documentation = Returns the day of the week, ranging from Sunday to Saturday.
com.ibm.odm.time.Date.getHourOfDay()#sentence.navigation = {hour of day} of {this}
com.ibm.odm.time.Date.getHourOfDay()#documentation = Returns the hour in a day, ranging from 0 to 23.
com.ibm.odm.time.Date.getMinuteOfHour()#sentence.navigation = {minute of hour} of {this}
com.ibm.odm.time.Date.getMinuteOfHour()#documentation = Returns the minute in an hour, ranging from 0 to 59.
com.ibm.odm.time.Date.getSecondOfMinute()#sentence.navigation = {second of minute} of {this}
com.ibm.odm.time.Date.getSecondOfMinute()#documentation = Returns the second in a minute, ranging from 0 to 59.

# The following operations convert a time point to the local time in
# another time zone. This time zone is specified by a name or is equal
# the time zone of another time point. The first time point is
# indicated by the placeholder {this} which may be filled by any
# expression of type com.ibm.odm.time.Date such as "the departure time
# of the flight". The time zone information is indicated by the
# placeholder {0}, which may be filled by the name of a time zone in
# the IANA Time Zone Database such as "Pacific/Midway" or by any
# expression of type com.ibm.odm.time.Date. This results in expressions
# such as "the local time of the departure time of the flight in
# "Pacific/Midway"". The term {local} is part of the operator name and
# needs to be translated. The placeholders {this} and {0} must not be
# translated.

com.ibm.odm.time.Date.inZone(string)#sentence.navigation = {local} time of {this} in {0}
com.ibm.odm.time.Date.inZone(string)#documentation = Converts the time point to the specified time zone. The time zone is based on the IANA Time Zone Database.
com.ibm.odm.time.Date.inSameZoneAs(com.ibm.odm.time.Date)#sentence.navigation = {local} time of {this} in the zone of {0}
com.ibm.odm.time.Date.inSameZoneAs(com.ibm.odm.time.Date)#documentation = Converts the first time point to the time zone of the second time point.

# The following operation determines whether two time points have the same
# instant of time. These time points are indicated by the placeholders
# {this} and {0}, which must not be translated and which may be filled
# by any expression of type com.ibm.odm.time.Date. This results into
# expressions such as "the departure time of the flight is at the same
# time as June 10, 2015 2:15:30 AM UTC-11:00.

com.ibm.odm.time.Date.equalSeconds(com.ibm.odm.time.Date)#sentence.navigation = {this} is at the same time as {0}
com.ibm.odm.time.Date.equalSeconds(com.ibm.odm.time.Date)#documentation = Checks whether the first time point is at the same time as the second time point.

# The following three operations determine whether a time point is
# after, before, or during a time period. The time point is indicated by
# the placeholder {this} which may be filled by any expression of type
# com.ibm.odm.time.Date and the time period is indicated by the
# placeholder {0} which may be filled by any expression of type
# com.ibm.ia.TimePeriod. This results in expressions such as "the
# check in event is during the period of 2 hours before 30 minutes before
# the departure time of the flight".

com.ibm.odm.time.Date.after(com.ibm.ia.TimePeriod)#sentence.navigation = {this} is after {0}
com.ibm.odm.time.Date.after(com.ibm.ia.TimePeriod)#documentation = Checks whether a time point is after a time period.
com.ibm.odm.time.Date.before(com.ibm.ia.TimePeriod)#sentence.navigation = {this} is before {0}
com.ibm.odm.time.Date.before(com.ibm.ia.TimePeriod)#documentation = Checks whether a time point is before a time period.
com.ibm.odm.time.Date.during(com.ibm.ia.TimePeriod)#sentence.navigation = {this} is during {0}
com.ibm.odm.time.Date.during(com.ibm.ia.TimePeriod)#documentation = Checks whether a time point is during a time period.

# The following seven operations determine whether two time points are in
# the same calendar period or time-of-day period. The time points are
# indicated by the placeholders {this} and {0}. These placeholders must
# not be translated and may be filled by any expression of type
# com.ibm.odm.time.Date such as "the departure time of the flight" and
# "the purchase event". This results in expressions such as "the
# departure time of the flight is on the same calendar day as the
# purchase event". The placeholder {this} and {0} must not be
# translated.

com.ibm.odm.time.Date.haveSameCalendarYear(com.ibm.odm.time.Date)#sentence.navigation = {this} is in the same calendar year as {0}
com.ibm.odm.time.Date.haveSameCalendarYear(com.ibm.odm.time.Date)#documentation = Checks whether two time points are in the same calendar year.
com.ibm.odm.time.Date.haveSameCalendarMonth(com.ibm.odm.time.Date)#sentence.navigation = {this} is in the same calendar month as {0}
com.ibm.odm.time.Date.haveSameCalendarMonth(com.ibm.odm.time.Date)#documentation = Checks whether two time points are in the same calendar month.
com.ibm.odm.time.Date.haveSameCalendarWeek(com.ibm.odm.time.Date)#sentence.navigation = {this} is in the same calendar week as {0}
com.ibm.odm.time.Date.haveSameCalendarWeek(com.ibm.odm.time.Date)#documentation = Checks whether two time points are in the same calendar week.
com.ibm.odm.time.Date.haveSameCalendarDay(com.ibm.odm.time.Date)#sentence.navigation = {this} is on the same calendar day as {0}
com.ibm.odm.time.Date.haveSameCalendarDay(com.ibm.odm.time.Date)#documentation = Checks whether two time points are on the same calendar day.
com.ibm.odm.time.Date.haveSameHourPeriod(com.ibm.odm.time.Date)#sentence.navigation = {this} is in the same hour as {0}
com.ibm.odm.time.Date.haveSameHourPeriod(com.ibm.odm.time.Date)#documentation = Checks whether two time points are in the same hour.
com.ibm.odm.time.Date.haveSameMinutePeriod(com.ibm.odm.time.Date)#sentence.navigation = {this} is in the same minute as {0}
com.ibm.odm.time.Date.haveSameMinutePeriod(com.ibm.odm.time.Date)#documentation = Checks whether two time points are in the same minute.
com.ibm.odm.time.Date.haveSameSecondPeriod(com.ibm.odm.time.Date)#sentence.navigation = {this} is in the same second as {0}
com.ibm.odm.time.Date.haveSameSecondPeriod(com.ibm.odm.time.Date)#documentation = Checks whether two time points are in the same second.

# The following four operations determine whether a time point is in the
# period of a specified duration that proceeds or succeeds another time
# point. The two time points are indicated by the placeholders {this}
# and {0} which may be filled by any expression of type
# com.ibm.odm.time.Date. The duration is indicated by the placeholder
# {1} which may be filled by any expression of type com.ibm.ia.CalendarDuration.
# This results in examples such as "the check in event is within 2 hours
# before 30 minutes before the departure time of the flight". The
# placeholders must not be translated.

com.ibm.odm.time.Date.isWithinPeriodBefore(com.ibm.ia.CalendarDuration,com.ibm.odm.time.Date)#sentence.navigation = {this} is within {0} before {1}
com.ibm.odm.time.Date.isWithinPeriodBefore(com.ibm.ia.CalendarDuration,com.ibm.odm.time.Date)#documentation = Checks whether the first time point is within the duration before the second time point.
com.ibm.odm.time.Date.isWithinPeriodAfter(com.ibm.ia.CalendarDuration,com.ibm.odm.time.Date)#sentence.navigation = {this} is within {0} after {1}
com.ibm.odm.time.Date.isWithinPeriodAfter(com.ibm.ia.CalendarDuration,com.ibm.odm.time.Date)#documentation = Checks whether the first time point is within the duration after the second time point.

# The following four operations check whether certain time components of
# a time point have a specified value. The time point is indicated by
# the placeholder {this} which may be filled by any expression of type
# com.ibm.odm.time.Date. The value is indicated by the placeholder {0}
# which may be filled by a number. This results in expressions such as
# "the arrival time of the flight is in hour 15". The placeholders must
# not be translated.

com.ibm.odm.time.Date.isOnDayOfMonth(int)#sentence.navigation = {this} is on day {0}
com.ibm.odm.time.Date.isOnDayOfMonth(int)#documentation = Checks whether a time point is on a day specified by a number ranging from 1 to 31.
com.ibm.odm.time.Date.isInHourOfDay(int)#sentence.navigation = {this} is in hour {0}
com.ibm.odm.time.Date.isInHourOfDay(int)#documentation = Checks whether a time point is in the specified hour ranging from 0 to 23.
com.ibm.odm.time.Date.isInMinuteOfHour(int)#sentence.navigation = {this} is in minute {0}
com.ibm.odm.time.Date.isInMinuteOfHour(int)#documentation = Checks whether a time point is in the specified minute ranging from 0 to 59.
com.ibm.odm.time.Date.isInSecondOfMinute(int)#sentence.navigation = {this} is in second {0}
com.ibm.odm.time.Date.isInSecondOfMinute(int)#documentation = Checks whether a time point is in the specified second ranging from 0 to 59.

#
# com.ibm.odm.time.SimpleDate
#

# Expressions of type com.ibm.odm.time.SimpleDate represent dates in the
# Gregorian calender. These dates are represented in terms of a year,
# a month of the year, and a day of the month. An example is June 10,
# 2015. Its string representation is 2015-06-10.

com.ibm.odm.time.SimpleDate#label = time.date

com.ibm.odm.time.SimpleDate.after(com.ibm.odm.time.SimpleDate)#sentence.navigation = {this} is after {0}
com.ibm.odm.time.SimpleDate.after(com.ibm.odm.time.SimpleDate)#documentation = Returns whether the first date is after the second date.
com.ibm.odm.time.SimpleDate.afterOrEquals(com.ibm.odm.time.SimpleDate)#sentence.navigation = {this} is after or the same as {0}
com.ibm.odm.time.SimpleDate.afterOrEquals(com.ibm.odm.time.SimpleDate)#documentation = Returns whether the first date is the same as or after the second date.

com.ibm.odm.time.SimpleDate.before(com.ibm.odm.time.SimpleDate)#sentence.navigation = {this} is before {0}
com.ibm.odm.time.SimpleDate.before(com.ibm.odm.time.SimpleDate)#documentation = Returns whether the first date is before the second date.
com.ibm.odm.time.SimpleDate.beforeOrEquals(com.ibm.odm.time.SimpleDate)#sentence.navigation = {this} is before or the same as {0}
com.ibm.odm.time.SimpleDate.beforeOrEquals(com.ibm.odm.time.SimpleDate)#documentation = Returns whether the first date is the same as or before the second date.

com.ibm.odm.time.SimpleDate.isAtDayOfWeek(com.ibm.odm.time.DayOfWeek)#sentence.navigation = {this} is on {0}
com.ibm.odm.time.SimpleDate.isAtDayOfWeek(com.ibm.odm.time.DayOfWeek)#documentation = Returns whether a date is on a specified day of week.
com.ibm.odm.time.SimpleDate.isAtMonth(com.ibm.odm.time.Month)#sentence.navigation = {this} is in {0}
com.ibm.odm.time.SimpleDate.isAtMonth(com.ibm.odm.time.Month)#documentation = Returns whether a date is in a specified month.
com.ibm.odm.time.SimpleDate.isAtMonthYear(com.ibm.odm.time.Month,com.ibm.odm.time.Year)#sentence.navigation = {this} is in {0} {1}
com.ibm.odm.time.SimpleDate.isAtMonthYear(com.ibm.odm.time.Month,com.ibm.odm.time.Year)#documentation = Returns whether a date is in a specified month and year.
com.ibm.odm.time.SimpleDate.isAtYear(com.ibm.odm.time.Year)#sentence.navigation = {this} is in {0}
com.ibm.odm.time.SimpleDate.isAtYear(com.ibm.odm.time.Year)#documentation = Returns whether a date is in a specified year.

com.ibm.odm.time.SimpleDate.isBetweenEE(com.ibm.odm.time.SimpleDate,com.ibm.odm.time.SimpleDate)#sentence.navigation = {this} is after {0} and before {1}
