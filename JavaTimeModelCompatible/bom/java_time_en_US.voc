#
# com.ibm.ia.TimePeriod
#

# A time period is defined by a start time and an end time and includes
# all time points that are later than or at the same instant as the
# start time and earlier than the end time. Particular examples for time
# periods are the calendar year 2015, the calendar month June 2015, and
# the calendar day June 10, 2015.

com.ibm.ia.TimePeriod#label = time.time period

# The following operation creates a time period for the given start and
# end time. These time points are indicated by the placeholders {0} and
# {1}, which must not be translated and which may be filled by any
# expression of type com.ibm.odm.time.Date. This results in examples
# such as "the period between the departure time of the flight and the
# arrival time of the flight". The term {period} is part of the
# operator name and needs to be translated.

com.ibm.ia.TimePeriod.create(com.ibm.odm.time.Date,com.ibm.odm.time.Date)#sentence.navigation = {period} between {0} and {1}
com.ibm.ia.TimePeriod.create(com.ibm.odm.time.Date,com.ibm.odm.time.Date)#documentation = Defines a time period with the specified start time and end time.

# The following four operations return the calendar year, the calendar
# month, the calendar week, and the calendar day that contain a given
# time point. The time point is indicated by the placeholder {0} which
# must not be translated and which may be filled by any expression of
# type com.ibm.odm.time.Date. The result is an expression of type
# com.ibm.ia.TimePeriod such as "the calendar day of the departure
# time of the flight".

com.ibm.ia.TimePeriod.asYear(com.ibm.odm.time.Date)#sentence.navigation = the calendar year of {0}
com.ibm.ia.TimePeriod.asYear(com.ibm.odm.time.Date)#documentation = Returns the calendar year that contains the specified time point.
com.ibm.ia.TimePeriod.asMonth(com.ibm.odm.time.Date)#sentence.navigation = the calendar month of {0}
com.ibm.ia.TimePeriod.asMonth(com.ibm.odm.time.Date)#documentation = Returns the calendar month that contains the specified time point.
com.ibm.ia.TimePeriod.asWeek(com.ibm.odm.time.Date)#sentence.navigation = the calendar week of {0}
com.ibm.ia.TimePeriod.asWeek(com.ibm.odm.time.Date)#documentation = Returns the calendar week that contains the specified time point.
com.ibm.ia.TimePeriod.asDay(com.ibm.odm.time.Date)#sentence.navigation = the calendar day of {0}
com.ibm.ia.TimePeriod.asDay(com.ibm.odm.time.Date)#documentation = Returns the calendar day that contains the specified time point.

# The following operations return the time periods that contain a given
# time point and that correspond to an hour, a minute, or a second
# during the time of day.  The time point is indicated by the
# placeholder {0} which must not be translated and which may be filled
# by any expression of type com.ibm.odm.time.Date. The result is an
# expression of type com.ibm.ia.TimePeriod such as "the hour of the
# departure time of the flight".

com.ibm.ia.TimePeriod.asHour(com.ibm.odm.time.Date)#sentence.navigation = the hour of {0}
com.ibm.ia.TimePeriod.asHour(com.ibm.odm.time.Date)#documentation = Returns the hour that contains the specified time point.
com.ibm.ia.TimePeriod.asMinute(com.ibm.odm.time.Date)#sentence.navigation = the minute of {0}
com.ibm.ia.TimePeriod.asMinute(com.ibm.odm.time.Date)#documentation = Returns the minute that contains the specified time point.
com.ibm.ia.TimePeriod.asSecond(com.ibm.odm.time.Date)#sentence.navigation = the second of {0}
com.ibm.ia.TimePeriod.asSecond(com.ibm.odm.time.Date)#documentation = Returns the second that contains the specified time point.

# The following operations access the start and the end times of a
# time period. The time period is indicated by the placeholder {this},
# which must not be translated and which may be filled by any
# expression of type com.ibm.ia.TimePeriod. The result is an
# expression of type com.ibm.odm.time.Date such as "the start time of
# the trip period". The terms {start} and {end} are parts of the
# operator names and must be translated.

com.ibm.ia.TimePeriod.getStartTime()#sentence.navigation = {start} of {this}
com.ibm.ia.TimePeriod.getStartTime()#documentation = Returns the start date of the time period.
com.ibm.ia.TimePeriod.getEndTime()#sentence.navigation =  {end} of {this}
com.ibm.ia.TimePeriod.getEndTime()#documentation =  Returns the end date of the time period.

# The following four operations determine a time point that proceeds or
# succeeds a given time period by a given duration. The time period is
# indicated by the placeholder {this}, which must not be translated and
# which may be filled by any expression of type
# com.ibm.ia.TimePeriod. The duration is indicated by the placeholder
# {0} which may be filled by any expression of type com.ibm.ia.CalendarDuration.
# This results in expressions of type com.ibm.odm.time.Date such as "30
# minutes after the meeting period".

# com.ibm.ia.TimePeriod.timeBefore(com.ibm.ia.CalendarDuration)#sentence.navigation = {0} before {this}
# com.ibm.ia.TimePeriod.timeBefore(com.ibm.ia.CalendarDuration)#documentation = Determines a time point by subtracting a calendar duration from the start of the time period.
# com.ibm.ia.TimePeriod.timeAfter(com.ibm.ia.CalendarDuration)#sentence.navigation = {0} after {this}
# com.ibm.ia.TimePeriod.timeAfter(com.ibm.ia.CalendarDuration)#documentation = Determines a time point by adding a calendar duration to the end of the time period.

# The following four operations determine a time period of a given
# duration that proceeds or succeeds another time period.  The time
# period is indicated by the placeholder {this}, which must not be
# translated and which may be filled by any expression of type
# com.ibm.ia.TimePeriod. The duration is indicated by the placeholder
# {0} which may be filled by any expression of type com.ibm.ia.CalendarDuration.
# This results in expressions of type com.ibm.ia.TimePeriod such as "the
# period of 30 minutes after the meeting period". The term {period} is
# part of the opeartor name and needs to be translated.

com.ibm.ia.TimePeriod.periodBefore(com.ibm.ia.CalendarDuration)#sentence.navigation = {period} of {0} before {this}
com.ibm.ia.TimePeriod.periodBefore(com.ibm.ia.CalendarDuration)#documentation = Defines a time period with the specified calendar duration that ends at the start of another time period.
com.ibm.ia.TimePeriod.periodAfter(com.ibm.ia.CalendarDuration)#sentence.navigation = {period} of {0} after {this}
com.ibm.ia.TimePeriod.periodAfter(com.ibm.ia.CalendarDuration)#documentation = Defines a time period with the specified calendar duration that starts at the end of another time period.

# The following five operations determine whether a time period is
# after, before, includes, starts at or ends at a time point. The time
# period is indicated by the placeholder {this} which may be filled by
# any expression of type com.ibm.ia.TimePeriod and the time point is
# indicated by the placeholder {0} which may be filled by any expression
# of type com.ibm.odm.time.Date. This results in expressions such as
# "the trip period includes the purchase event".

com.ibm.ia.TimePeriod.after(com.ibm.odm.time.Date)#sentence.navigation = {this} is after {0}
com.ibm.ia.TimePeriod.after(com.ibm.odm.time.Date)#documentation = Checks whether the time period is after the specified time point.
com.ibm.ia.TimePeriod.before(com.ibm.odm.time.Date)#sentence.navigation = {this} is before {0}
com.ibm.ia.TimePeriod.before(com.ibm.odm.time.Date)#documentation = Checks whether the time period is before the specified time point.
com.ibm.ia.TimePeriod.contains(com.ibm.odm.time.Date)#sentence.navigation = {this} includes {0}
com.ibm.ia.TimePeriod.contains(com.ibm.odm.time.Date)#documentation = Checks whether the time period includes the specified time point.
com.ibm.ia.TimePeriod.startsAt(com.ibm.odm.time.Date)#sentence.navigation = {this} starts at {0}
